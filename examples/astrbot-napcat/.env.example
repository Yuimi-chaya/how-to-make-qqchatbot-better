# Fill verified tags or digests; empty values deliberately prevent startup.
# Image repositories: soulter/astrbot and mlikiowa/napcat-docker.
ASTRBOT_IMAGE=
NAPCAT_IMAGE=
# Keep WebUIs local by default. Use 0.0.0.0 for direct IP access only after
# restricting access at the cloud/network boundary; public HTTP is not private.
ADMIN_BIND_IP=127.0.0.1
# Set these to the intended owner of NapCat's bind-mounted directories.
NAPCAT_UID=1000
NAPCAT_GID=1000
